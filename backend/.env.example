# Application
APP_NAME=Personal AI OS
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security — CHANGE IN PRODUCTION
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://neondb_owner:npg_HbmXCFD91tvZ@ep-sweet-butterfly-ax9eswwv-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_SYNC=postgresql://neondb_owner:npg_HbmXCFD91tvZ@ep-sweet-butterfly-ax9eswwv-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Google OAuth (create credentials in Google Cloud Console)
